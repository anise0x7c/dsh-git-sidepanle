{
  "name": "@local/dsh-git-graph",
  "version": "0.8.0",
  "private": true,
  "description": "A VS Code-style Git source-control sidebar for the DeepSeek Harness Web GUI",
  "type": "module",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "index.js.map",
    "client.js",
    "client.js.map",
    "cordis.patch.yml",
    "src",
    "locale/*.json",
    "docs",
    "README.md",
    "icon.svg"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0",
    "node": ">=22"
  },
  "license": "MIT",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build": "node --import tsx scripts/build.ts",
    "dev": "node --import tsx scripts/build.ts --watch",
    "test": "pnpm build && pnpm test:run",
    "test:run": "node --import tsx --test test/*.test.ts test/unit/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm test:run && pnpm check:build",
    "check:build": "node --import tsx scripts/build.ts --check",
    "verify:contract": "node --import tsx scripts/verify-contract.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.27",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
