{
  "name": "@local/dsh-git-graph",
  "version": "0.3.0",
  "private": true,
  "description": "A VS Code-style Git source-control sidebar for the DeepSeek Harness Web GUI",
  "type": "module",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "client.js.map",
    "cordis.patch.yml",
    "src",
    "locale/*.json",
    "docs",
    "README.md",
    "icon.svg"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0",
    "node": ">=22"
  },
  "license": "MIT",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "dev": "node scripts/build-client.mjs --watch",
    "pretest": "node scripts/build-client.mjs",
    "test": "node --test test/*.test.mjs test/unit/*.test.mjs",
    "check:build": "node scripts/build-client.mjs --check",
    "verify:contract": "node scripts/verify-contract.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
